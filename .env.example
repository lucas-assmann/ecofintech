# Copie para .env e ajuste os valores
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/ecofintech

# Segredo para assinar os tokens (gere um valor longo e aleatório; nunca reutilize o de dev em produção)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Validade do token em segundos (3600 = 1 hora)
JWT_EXPIRES_IN=3600

# Endereços do front autorizados a chamar a API (separados por vírgula)
# 5173 = Vite (React/Vue), 8081 = Expo (React Native web)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
