generator client {
  provider            = "prisma-client"
  output              = "./generated/prisma"
  previewFeatures     = ["partialIndexes"]
  importFileExtension = "js"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
}

model schema_migrations {
  name       String   @id
  applied_at DateTime @default(now()) @db.Timestamptz(6)

  @@ignore
}

model users {
  id                                                             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                                           String
  email                                                          String                  @unique
  password_hash                                                  String
  created_at                                                     DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                                                     DateTime                @default(now()) @db.Timestamptz(6)
  date_of_birth                                                  DateTime                @db.Date
  role                                                           user_role               @default(user)
  cpf                                                            String                  @unique @db.Char(11)
  phone                                                          String                  @db.VarChar(11)
  status                                                         user_status             @default(active)
  deactivated_at                                                 DateTime?               @db.Timestamptz(6)
  token_version                                                  Int                     @default(0)
  accounts                                                       accounts?
  deactivation_requests_deactivation_requests_reviewed_byTousers deactivation_requests[] @relation("deactivation_requests_reviewed_byTousers")
  deactivation_requests_deactivation_requests_user_idTousers     deactivation_requests?  @relation("deactivation_requests_user_idTousers")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model accounts {
  id                                                          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                                     String         @unique @db.Uuid
  balance                                                     Decimal        @default(0) @db.Decimal(15, 2)
  created_at                                                  DateTime       @default(now()) @db.Timestamptz(6)
  updated_at                                                  DateTime       @default(now()) @db.Timestamptz(6)
  users                                                       users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transactions_transactions_account_idToaccounts              transactions[] @relation("transactions_account_idToaccounts")
  transactions_transactions_counterparty_account_idToaccounts transactions[] @relation("transactions_counterparty_account_idToaccounts")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transactions {
  id                                                      String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id                                              String               @db.Uuid
  type                                                    transaction_type
  category                                                transaction_category
  amount                                                  Decimal              @db.Decimal(15, 2)
  balance_after                                           Decimal              @db.Decimal(15, 2)
  counterparty_account_id                                 String?              @db.Uuid
  description                                             String?
  created_at                                              DateTime             @default(now()) @db.Timestamptz(6)
  accounts_transactions_account_idToaccounts              accounts             @relation("transactions_account_idToaccounts", fields: [account_id], references: [id], onUpdate: NoAction)
  accounts_transactions_counterparty_account_idToaccounts accounts?            @relation("transactions_counterparty_account_idToaccounts", fields: [counterparty_account_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([account_id, created_at(sort: Desc)])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model deactivation_requests {
  id                                             String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                        String                      @unique(map: "deactivation_requests_one_pending_per_user", where: raw("(status = 'pending'::deactivation_request_status)")) @db.Uuid
  status                                         deactivation_request_status @default(pending)
  reason                                         String?
  requested_at                                   DateTime                    @default(now()) @db.Timestamptz(6)
  reviewed_by                                    String?                     @db.Uuid
  reviewed_at                                    DateTime?                   @db.Timestamptz(6)
  review_note                                    String?
  users_deactivation_requests_reviewed_byTousers users?                      @relation("deactivation_requests_reviewed_byTousers", fields: [reviewed_by], references: [id], onUpdate: NoAction)
  users_deactivation_requests_user_idTousers     users                       @relation("deactivation_requests_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum user_role {
  user
  admin
}

enum transaction_category {
  deposito
  transferencia
}

enum transaction_type {
  entrada
  saida
}

enum deactivation_request_status {
  pending
  approved
  rejected
}

enum user_status {
  active
  deactivated
}
